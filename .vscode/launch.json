{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug miniRT",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/miniRT",
            "args": ["test_files/scene.rt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build miniRT",
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
